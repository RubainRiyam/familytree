# Public client settings for the Expo app (inlined into the bundle at build time).
# Only the project URL and the anon/publishable key belong here. NEVER put the service-role or
# a secret key in any EXPO_PUBLIC_ variable: the app refuses to start with one.
# Copy to apps/app/.env and fill in once the Supabase project (Mumbai, ap-south-1) exists.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
